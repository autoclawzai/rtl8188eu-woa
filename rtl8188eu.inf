; rtl8188eu.inf - Phase 5b: native WiFiCx adapter (class Net) for TP-Link TL-WN722N v3 (RTL8188EUS)
[Version]
Signature   = "$WINDOWS NT$"
Class       = Net
ClassGuid   = {4d36e972-e325-11ce-bfc1-08002be10318}
Provider    = %ManufacturerName%
CatalogFile = rtl8188eu.cat
DriverVer   = 10/05/2026,1.0.0.0
PnpLockdown = 1

[DestinationDirs]
DefaultDestDir = 13

[SourceDisksNames]
1 = %DiskName%

[SourceDisksFiles]
rtl8188eu.sys = 1

[Manufacturer]
%ManufacturerName% = Standard,NTarm64.10.0...16299

[Standard.NTarm64.10.0...16299]
%DeviceDesc% = Install.ndi, USB\VID_2357&PID_010C

[Install.ndi.NT]
CopyFiles       = Drivers_Dir
Characteristics = 0x84      ; NCF_HAS_UI | NCF_PHYSICAL
BusType         = 15        ; PNPBus
AddReg          = Install.reg
*IfType            = 71     ; IF_TYPE_IEEE80211
*MediaType         = 16     ; NdisMediumNative802_11
*PhysicalMediaType = 9      ; NdisPhysicalMediumNative802_11

[Drivers_Dir]
rtl8188eu.sys

[Install.ndi.NT.Services]
AddService = rtl8188eu, 0x00000002, Service_Install

[Service_Install]
DisplayName   = %ServiceDesc%
ServiceType   = 1
StartType     = 3
ErrorControl  = 1
ServiceBinary = %13%\rtl8188eu.sys

[Install.ndi.NT.Wdf]
KmdfService = rtl8188eu, Wdf_Install

[Wdf_Install]
KmdfLibraryVersion = $KMDFVERSION$

[Install.reg]
HKR, Ndi,            Service,    0, "rtl8188eu"
HKR, Ndi\Interfaces, UpperRange, 0, "ndis5"
HKR, Ndi\Interfaces, LowerRange, 0, "wlan,ethernet"
HKR, NetworkInterface, *IfConnectorPresent, 0x00010001, 1
HKR, NetworkInterface, *ConnectionType,     0x00010001, 1
HKR, NetworkInterface, *DirectionType,      0x00010001, 0
HKR, NetworkInterface, *AccessType,         0x00010001, 2
HKR, NetworkInterface, *HardwareLoopback,   0x00010001, 0
HKR, , NumberOfNetworkInterfaces, 0x00010001, 5

[Strings]
ManufacturerName = "rtl8188eu-port"
DiskName         = "rtl8188eu install disk"
DeviceDesc       = "RTL8188EUS 802.11n USB Wireless Adapter (WiFiCx test)"
ServiceDesc      = "rtl8188eu WiFiCx test driver"
